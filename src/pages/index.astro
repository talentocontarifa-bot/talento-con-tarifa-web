---
import Layout from '../layouts/Layout.astro';

// Configuración centralizada de WhatsApp
const WHATSAPP_NUMBER = "525644982624"; // Número oficial de Talento con Tarifa
const DEFAULT_MSG = "Hola. Llegué por curiosidad. Quiero ver qué tan profundo llega el agujero del conejo.";
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(DEFAULT_MSG)}`;
---

<Layout title="Talento con Tarifa | Agencia Irreverente // Brinca al Vacío">

	<!-- HERO SECTION (#CCFF00 AMARILLO CHILLANTE TOTAL) -->
	<header class="pt-24 pb-20 md:pt-36 md:pb-28 px-4 sm:px-6 relative overflow-hidden bg-[#CCFF00] border-b-4 border-black">
		
		<!-- Halftone Dot Pattern -->
		<div class="absolute inset-0 opacity-15 pointer-events-none" style="background-image:radial-gradient(circle, #000 2px, transparent 2px);background-size:24px 24px"></div>

		<div class="max-w-7xl mx-auto relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
			
			<!-- Left Column: The Statement / Manifesto (7 Cols) -->
			<div class="lg:col-span-7 space-y-6">
				
				<!-- Badge Tilted -->
				<div class="inline-block bg-black text-[#CCFF00] px-4 py-1.5 font-mono font-bold text-xs sm:text-sm tracking-widest uppercase transform -rotate-2 border-2 border-black shadow-[4px_4px_0px_0px_rgba(255,255,255,1)]">
					AGENCIA IRREVERENTE // STATEMENT 01
				</div>

				<!-- Main Headline -->
				<h1 class="text-5xl sm:text-7xl lg:text-8xl font-black leading-[0.92] tracking-tighter text-black uppercase">
					SI LLEGASTE AQUÍ <br/>
					<span class="bg-white px-3 py-1 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] text-black inline-block transform rotate-1 my-2">
						TIENES CURIOSIDAD.
					</span> <br/>
					<span class="text-transparent" style="-webkit-text-stroke: 3px #000; text-stroke: 3px #000;">EL MUNDO ES VASTO.</span>
				</h1>

				<!-- Dorothy Quote / Offset Callout Box -->
				<div class="bg-white border-4 border-black p-5 sm:p-6 shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] transform -rotate-1 max-w-xl">
					<p class="text-xl sm:text-2xl font-black italic text-black leading-snug">
						“Brinca al vacío, Dorothy. Háblame y veamos qué tan profundo llega el agujero del conejo.”
					</p>
				</div>

				<!-- Reality Punch -->
				<p class="text-lg sm:text-xl font-bold text-black max-w-xl leading-relaxed">
					Sigues haciendo a mano lo que tu competencia ya automatizó. No es que no sepas vender: <strong class="underline decoration-4">estás haciendo trabajo de robot con manos de humano.</strong>
				</p>

				<!-- CTA 1 (Hero) -->
				<div class="pt-2 flex flex-col sm:flex-row items-start sm:items-center gap-4">
					<a 
						href={WHATSAPP_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="w-full sm:w-auto bg-black text-[#CCFF00] px-8 py-5 text-xl font-black border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:bg-white hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:translate-x-2 active:translate-y-2 active:shadow-none transition-none flex items-center justify-center gap-3 group"
					>
						<span>HÁBLAME, PLATICAMOS</span>
						<svg class="w-6 h-6 text-[#CCFF00] group-hover:text-black transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12.004 2C6.479 2 2 6.48 2 12c0 1.89.525 3.66 1.438 5.178L2 22l4.974-1.39A9.957 9.957 0 0012.004 22C17.528 22 22 17.52 22 12c0-5.52-4.472-10-9.996-10zm5.837 14.223c-.244.686-1.42 1.309-1.983 1.393-.505.076-1.144.108-1.846-.118-.427-.137-.974-.316-1.673-.618-2.955-1.274-4.887-4.24-5.035-4.436-.148-.196-1.198-1.595-1.198-3.042 0-1.447.76-2.158 1.03-2.453.27-.294.59-.368.787-.368.196 0 .393.002.565.01.18.009.421-.069.66.505.244.587.835 2.036.908 2.184.074.148.123.321.025.518-.098.196-.148.318-.295.49-.148.173-.31.385-.443.518-.148.147-.302.308-.13.603.172.296.76 1.256 1.63 2.032 1.121 1.001 2.066 1.31 2.36 1.458.295.147.467.123.64-.074.172-.197.737-.858.934-1.152.196-.295.393-.246.66-.148.27.098 1.714.808 2.009.955.295.148.491.222.565.344.074.123.074.71-.17 1.396z"/>
						</svg>
					</a>
				</div>

				<!-- Exclusivity Filter -->
				<div class="inline-block bg-white text-black border-2 border-black px-3.5 py-1.5 font-mono text-xs font-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transform -rotate-1">
					<span class="text-[#FF0055]">⚠</span> NO NOS INTERESA TENER MUCHOS CLIENTES. NOS INTERESA CONECTAR CON LOS CORRECTOS.
				</div>

			</div>

			<!-- Right Column: Official Brain Asset with Cybernetic Status (5 Cols) -->
			<div class="lg:col-span-5 flex justify-center relative py-6">
				
				<!-- Hard Shadow Disk -->
				<div class="absolute w-72 h-72 sm:w-96 sm:h-96 rounded-full bg-black -bottom-3 -right-3 hidden sm:block"></div>

				<!-- Brain Card Showcase Container -->
				<div class="relative w-full max-w-sm sm:max-w-md bg-white border-4 border-black p-6 sm:p-7 shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] flex flex-col items-center">
					
					<!-- Brain Graphic Frame -->
					<div class="w-full relative flex justify-center items-center p-4 bg-[#F5F5F5] border-2 border-black overflow-hidden group">
						<img 
							src="/cerebro.webp" 
							alt="Cerebro Agencial Talento con Tarifa" 
							class="w-full max-w-[260px] sm:max-w-[300px] h-auto object-contain transition-transform duration-300 group-hover:scale-105"
						/>
						<div class="absolute inset-0 bg-[#CCFF00] mix-blend-multiply opacity-15 pointer-events-none"></div>
					</div>

					<!-- Pink Warning Sticker Overlapping -->
					<div class="transform -rotate-3 -mt-5 bg-[#FF0055] text-white font-mono text-xs sm:text-sm uppercase px-4 py-2 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] font-black z-20">
						DON'T TOUCH THE BRAIN // 100% AUTOMATED
					</div>

					<!-- Brutalist Status Ticker Inside Card -->
					<div class="w-full mt-6 pt-4 border-t-2 border-black flex justify-between items-center text-left">
						<div>
							<span class="font-mono text-[10px] uppercase font-bold text-gray-600 block">CAPACIDAD MOTOR</span>
							<p class="font-mono text-lg sm:text-xl font-black text-black">4,800 MSG/MIN</p>
						</div>
						<div class="transform rotate-2 bg-[#CCFF00] px-3 py-1 border-2 border-black font-mono text-[11px] font-black shadow-[3px_3px_0px_0px_#000]">
							⚡ 24/7/365 SIN VACACIONES
						</div>
					</div>

				</div>
			</div>

		</div>
	</header>


	<!-- ROTATED MARQUEE TICKER TAPE -->
	<div class="bg-black text-[#CCFF00] py-4 overflow-hidden border-y-4 border-black transform rotate-1 scale-105 z-20 relative shadow-[0_10px_20px_rgba(0,0,0,0.4)] select-none">
		<div class="whitespace-nowrap animate-marquee flex gap-8 font-heading font-black text-2xl uppercase tracking-wider">
			<span class="flex items-center gap-4">★ SE RENTA TALENTO CON TARIFA</span>
			<span class="flex items-center gap-4">★ EL MUNDO ES VASTO</span>
			<span class="flex items-center gap-4">★ BRINCA AL VACÍO, DOROTHY</span>
			<span class="flex items-center gap-4">★ TRABAJO DE ROBOT PARA ROBOTS</span>
			<span class="flex items-center gap-4">★ COTIZACIONES EN 15 SEGUNDOS</span>
			<span class="flex items-center gap-4">★ CERO CORTESÍA CORPORATIVA</span>
			<span class="flex items-center gap-4">★ 100% BOT ROUTED</span>
			<span class="flex items-center gap-4">★ SE RENTA TALENTO CON TARIFA</span>
			<span class="flex items-center gap-4">★ EL MUNDO ES VASTO</span>
			<span class="flex items-center gap-4">★ BRINCA AL VACÍO, DOROTHY</span>
			<span class="flex items-center gap-4">★ TRABAJO DE ROBOT PARA ROBOTS</span>
			<span class="flex items-center gap-4">★ COTIZACIONES EN 15 SEGUNDOS</span>
			<span class="flex items-center gap-4">★ CERO CORTESÍA CORPORATIVA</span>
			<span class="flex items-center gap-4">★ 100% BOT ROUTED</span>
		</div>
	</div>


	<!-- SECTION: EL DOLOR SIN RODEOS (3 Direct Brutalist Feature Cards) -->
	<section class="py-24 px-4 sm:px-6 bg-[#FAFAFA] border-b-4 border-black relative">
		
		<!-- Subtle Cross Pattern -->
		<div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image:linear-gradient(to right, #000 1px, transparent 1px), linear-gradient(to bottom, #000 1px, transparent 1px); background-size:24px 24px;"></div>

		<div class="max-w-7xl mx-auto space-y-16 relative z-10">
			
			<div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
				<div class="max-w-3xl space-y-4">
					<div class="inline-block bg-[#CCFF00] text-black border-2 border-black px-3.5 py-1.5 font-mono text-xs font-black transform -rotate-1 shadow-[3px_3px_0px_0px_#000]">
						LA REALIDAD // BOTS DE IMPACTO INMEDIATO
					</div>
					<h2 class="text-4xl sm:text-6xl font-black text-black leading-none uppercase tracking-tight">
						TRES COSAS QUE TUS HUMANOS <br/><span class="bg-black text-white px-2">NO DEBERÍAN ESTAR HACIENDO</span>.
					</h2>
				</div>
				<div class="font-mono text-xs font-black uppercase text-gray-700 max-w-xs border-l-4 border-black pl-4">
					[MÓDULOS DE DISRUPCIÓN DE EMBUDO COMERCIAL]
				</div>
			</div>

			<!-- 3 Direct Brutalist Cards -->
			<div class="grid md:grid-cols-3 gap-8">
				
				<!-- Card 1: Velocidad -->
				<div class="bg-white border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between">
					<div class="space-y-5">
						<div class="flex justify-between items-center">
							<span class="bg-black text-white font-mono text-xs px-3 py-1 uppercase font-bold">
								01 // VELOCIDAD
							</span>
							<span class="bg-[#CCFF00] text-black font-mono text-xs font-black px-2.5 py-1 border-2 border-black">
								⚡ 15 SEGUNDOS
							</span>
						</div>
						<h3 class="text-2xl font-black uppercase text-black">Cotizaciones en 15 Segundos</h3>
						<p class="font-bold text-gray-800 text-base leading-relaxed">
							Tu prospecto pregunta a las 11:45 PM y en 15 segundos recibe una propuesta personalizada con cálculo exacto en PDF por WhatsApp. Tu competencia contesta al mediodía siguiente cuando el cliente ya olvidó su interés.
						</p>
					</div>
					<div class="pt-6 mt-6 border-t-2 border-black">
						<div class="bg-[#F0F0F0] p-3 border-2 border-black font-mono text-xs uppercase font-black flex items-center justify-between">
							<span>Resultado Directo</span>
							<span class="text-[#FF0055]">3.8x CIERRE EN FRÍO</span>
						</div>
					</div>
				</div>

				<!-- Card 2: Protagonista (Elevated Yellow) -->
				<div class="bg-[#CCFF00] border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] transform md:-translate-y-4 rotate-1 hover:rotate-0 hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between relative">
					<!-- Top Sticker -->
					<div class="absolute -top-4 right-4 bg-[#FF0055] text-white font-mono text-xs uppercase px-3 py-1 font-black border-2 border-black transform rotate-3 shadow-[3px_3px_0px_0px_#000]">
						MÁS RENTABLE
					</div>

					<div class="space-y-5">
						<div class="flex justify-between items-center">
							<span class="bg-black text-[#CCFF00] font-mono text-xs px-3 py-1 uppercase font-black">
								02 // PROTAGONISTA
							</span>
							<span class="bg-white text-black font-mono text-xs font-black px-2.5 py-1 border-2 border-black">
								📈 +35% RECUPERADOS
							</span>
						</div>
						<h3 class="text-2xl font-black uppercase text-black">Seguimiento Implacable</h3>
						<p class="font-black text-black text-base leading-relaxed">
							El 80% de las ventas ocurren después del quinto contacto. Tus comerciales se rinden en el segundo o se les olvida. Nuestro bot nunca se cansa ni le da pena insistir con ángulos nuevos y valor real.
						</p>
					</div>
					<div class="pt-6 mt-6 border-t-2 border-black">
						<div class="bg-white p-3 border-2 border-black font-mono text-xs uppercase font-black flex items-center justify-between">
							<span>Estado de Leads</span>
							<span class="text-black underline decoration-2">CERO EN EL LIMBO</span>
						</div>
					</div>
				</div>

				<!-- Card 3: Filtro Duro -->
				<div class="bg-white border-4 border-black p-8 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] transition-all flex flex-col justify-between">
					<div class="space-y-5">
						<div class="flex justify-between items-center">
							<span class="bg-black text-white font-mono text-xs px-3 py-1 uppercase font-bold">
								03 // CALIFICACIÓN
							</span>
							<span class="bg-[#CCFF00] text-black font-mono text-xs font-black px-2.5 py-1 border-2 border-black">
								🛡️ FILTRO DURO
							</span>
						</div>
						<h3 class="text-2xl font-black uppercase text-black">Filtro de Curiosos</h3>
						<p class="font-bold text-gray-800 text-base leading-relaxed">
							Deja de regalar videollamadas a gente sin presupuesto. El filtro detecta capacidad de pago, urgencia y seriedad técnica antes de si quiera tocar tu calendario o el de tus cerradores.
						</p>
					</div>
					<div class="pt-6 mt-6 border-t-2 border-black">
						<div class="bg-[#F0F0F0] p-3 border-2 border-black font-mono text-xs uppercase font-black flex items-center justify-between">
							<span>Calidad Calendario</span>
							<span class="text-[#FF0055]">SOLO HIGH-TICKET</span>
						</div>
					</div>
				</div>

			</div>

			<!-- Mid CTA 2 -->
			<div class="border-4 border-black bg-[#CCFF00] p-8 sm:p-10 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] flex flex-col md:flex-row items-center justify-between gap-6">
				<div class="space-y-1 text-center md:text-left">
					<h3 class="text-2xl sm:text-3xl font-black text-black uppercase">¿Quieres ver cómo funciona en tu negocio?</h3>
					<p class="font-bold text-black/85 text-base sm:text-lg">Sin presentaciones aburridas. Una plática directa de 10 minutos.</p>
				</div>
				<a 
					href={WHATSAPP_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="shrink-0 bg-black text-[#CCFF00] px-8 py-4 font-black text-lg border-2 border-black shadow-[4px_4px_0px_0px_#000] hover:bg-white hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none active:translate-x-2 active:translate-y-2 transition-none uppercase tracking-wider"
				>
					HÁBLAME, PLATICAMOS
				</a>
			</div>

		</div>
	</section>


	<!-- SECTION: LA COHERENCIA & DOGFOODING (Black background, bold statement) -->
	<section class="py-24 px-4 sm:px-6 bg-black text-white border-b-4 border-black relative overflow-hidden">
		<div class="max-w-7xl mx-auto space-y-12">
			
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
				
				<div class="lg:col-span-8 space-y-8">
					<!-- Terminal Status Pill -->
					<div class="font-mono text-xs text-[#CCFF00] bg-[#111118] border-2 border-[#CCFF00] px-4 py-1.5 inline-block uppercase font-bold shadow-[4px_4px_0px_0px_#CCFF00]">
						[SYS_STATUS: VERIFIED_IN_PRODUCTION // ZERO_HUMAN_INTERMEDIARIES]
					</div>

					<!-- Monumental Authority Headline -->
					<h2 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white leading-tight uppercase tracking-tight">
						NO VENDEMOS LO QUE <br/>
						<span class="text-[#CCFF00] underline decoration-[#CCFF00] decoration-8 underline-offset-8">NO USAMOS NOSOTROS</span>.
					</h2>

					<!-- Highlight Quote Box -->
					<div class="border-l-8 border-[#CCFF00] pl-6 py-2 max-w-3xl">
						<p class="text-gray-300 text-lg sm:text-2xl font-bold leading-relaxed">
							“Nuestros propios bots te trajeron a esta pantalla. Operamos exactamente con los mismos motores que te instalamos. Cero llamadas en frío no deseadas, cero comerciales rogando por 5 minutos de tu tiempo.”
						</p>
					</div>

					<!-- Brutalist Metric Blocks -->
					<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 font-mono">
						<div class="border-2 border-[#CCFF00] p-5 bg-[#0A0A0F] shadow-[4px_4px_0px_0px_#CCFF00]">
							<span class="text-xs uppercase text-gray-400 block font-bold mb-1">EQUIPO COMERCIAL</span>
							<span class="text-3xl sm:text-4xl font-black text-white block">0 HUMANOS</span>
						</div>
						<div class="border-2 border-[#CCFF00] p-5 bg-[#0A0A0F] shadow-[4px_4px_0px_0px_#CCFF00]">
							<span class="text-xs uppercase text-gray-400 block font-bold mb-1">ENRUTAMIENTO</span>
							<span class="text-3xl sm:text-4xl font-black text-white block">100% BOTS</span>
						</div>
						<div class="border-2 border-[#CCFF00] p-5 bg-[#0A0A0F] shadow-[4px_4px_0px_0px_#CCFF00]">
							<span class="text-xs uppercase text-gray-400 block font-bold mb-1">VELOCIDAD SLA</span>
							<span class="text-3xl sm:text-4xl font-black text-[#CCFF00] block">&lt; 15 SEG</span>
						</div>
					</div>
				</div>

				<!-- Dogfooding Visual Tag / Terminal Badge -->
				<div class="lg:col-span-4 flex flex-col items-center justify-center text-center">
					<div class="transform rotate-2 bg-[#FF0055] text-white p-8 border-4 border-white shadow-[8px_8px_0px_0px_#CCFF00] w-full max-w-sm space-y-4">
						<div class="text-5xl">⚡</div>
						<h3 class="text-2xl font-black uppercase leading-tight">
							DOGFOODING OBSESIVO
						</h3>
						<p class="font-mono text-xs uppercase font-bold text-white/95 leading-relaxed">
							Pruébalo en vivo en menos de 2 minutos. Si no te convence cómo te atendemos, te quedas con la arquitectura.
						</p>
						<a 
							href={WHATSAPP_URL}
							target="_blank"
							rel="noopener noreferrer"
							class="block w-full bg-[#CCFF00] text-black font-black text-base uppercase py-3.5 border-2 border-black shadow-[4px_4px_0px_0px_#000] hover:bg-white transition-none active:translate-x-1 active:translate-y-1 active:shadow-none"
						>
							TESTEAR BOT AHORA
						</a>
					</div>
				</div>

			</div>

		</div>
	</section>


	<!-- SECTION: CIERRE FINAL (#CCFF00 TOTAL, MASIVO) -->
	<section class="py-28 px-4 sm:px-6 bg-[#CCFF00] text-center relative overflow-hidden">
		
		<div class="max-w-4xl mx-auto space-y-8 relative z-10">
			
			<div class="inline-block bg-black text-[#CCFF00] px-4 py-1.5 font-mono font-bold text-xs uppercase transform -rotate-2 border-2 border-black shadow-[4px_4px_0px_0px_#FFF]">
				ACCESO INMEDIATO // SIN FILTROS NI AGENDAS ETERNAS
			</div>

			<h2 class="text-5xl sm:text-7xl lg:text-8xl font-black text-black leading-none uppercase tracking-tighter">
				BRINCA AL VACÍO. <br/>
				<span class="bg-white px-3 py-1 border-4 border-black shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] text-black inline-block transform rotate-1 my-3">
					HÁBLAME, PLATICAMOS.
				</span>
			</h2>

			<p class="text-lg sm:text-2xl font-black text-black max-w-2xl mx-auto leading-relaxed">
				Dale click al botón verde radioactivo. Te va a responder una máquina que entiende mejor de tus cuellos de botella comerciales que cualquier consultor con traje alquilado.
			</p>

			<!-- CTA 3 (Cierre Gigante) -->
			<div class="pt-4">
				<a 
					href={WHATSAPP_URL}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-4 bg-black text-[#CCFF00] hover:bg-white hover:text-black px-8 sm:px-12 py-6 text-xl sm:text-3xl font-black border-4 border-black shadow-[10px_10px_0px_0px_rgba(0,0,0,1)] hover:translate-x-1 hover:translate-y-1 hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] active:translate-x-2 active:translate-y-2 active:shadow-none transition-none uppercase tracking-tight group"
				>
